# Copy this file to .env and fill in real values. NEVER commit .env or paste keys in chat.
# No spaces around "=" in variable lines.

# Azure AI Foundry (OpenAI-compatible endpoint) and API key. The same key is used for chat and embeddings.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<your-api-key>

# Embeddings endpoint (OPTIONAL: leave this out if it is the same as AZURE_OPENAI_ENDPOINT)
EMBEDDING_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1

# Deployment names = the names you gave the models in Azure (sent as the "model" in requests)
CHAT_DEPLOYMENT=gpt-4.1-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
